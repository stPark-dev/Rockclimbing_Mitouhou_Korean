{
 "_rules": {
  "basis": "D4: 원문 의미 번역. 게임 오리지널 이름(산 별칭·루트·스테이지)은 뜻을 살려 옮긴다(실명 병기 안 함). 실존 인물·지명은 외래어 표기법.",
  "climbing": "D4: 등반 용어는 외래어 음역(국내 등반계 표기). 원문이 괄호로 풀이한 용어는 풀이도 함께 옮긴다.",
  "voice": "D5: 화자 단위로 통일. 클라이머 독백은 반말(결심 ~하자!/~하겠어!, 안도 ~겠네./~같아., 경고 ~다!/~야!, 실수 ~말았어./~버렸군.). 전문가 경고·설명은 ~입니다./~하십시오., 시스템 사건 서술은 ~했습니다./~합니다.",
  "punctuation": "D4: 。→. 、→, (글리프 새로 추가). 전각 기호 ：（）＃・～ 와 전각 숫자는 원문 글리프 그대로.",
  "status": "approved = 사용자 확인, provisional = 사용자가 잠정 채택, candidate = 원칙상 후보, check = 확인 필요",
  "kinds": "peak 봉우리 별칭, route 루트, stage 스테이지, tech 등반 기술, gear 장비, term 등산 용어, ui 시스템, person 실존 인물, place 실존 지명",
  "name_slot": "D5: {F8:00}(이름으로 추정) 뒤에 받침 의존 조사를 쓰지 않는다. 「쪽으로/쪽을」「에게」「{이름}, …」 문형. 「의 몸이」 반복 금지.",
  "numbers": "D6: 런타임 숫자({FA:xx}) 뒤에 받침 의존 조사(로/으로, 은/는 등)를 쓰지 않는다. '{숫자}번 스테이지로'처럼 고정 단어를 사이에 둔다. 숫자 조사: 1·2·4·5·7·8·9는 로, 3·6·10은 으로(ㄹ 받침 예외 포함).",
  "short_names": "D7: 좁은 칸 확정 약칭. 스테이지·루트 이름은 목록·정보·계획·저장 슬롯 화면에서 약칭으로 통일. 산 이름은 넓은 칸 정식명, 좁은 칸 약칭. 설명문 서술은 정식 표현."
 },
